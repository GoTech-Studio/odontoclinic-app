# Configuración de contacto Odontoclinic
# Reemplaza con el número real de WhatsApp de la clínica (con código de país, ej: 59174649956)
NEXT_PUBLIC_WHATSAPP_PHONE=59174649956

# Conexión opcional con Google Places API para reseñas en vivo de Google Maps
# Obtén tu API Key en: https://console.cloud.google.com/ (Habilitar "Places API")
# Encuentra tu Place ID en: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ==============================================================================
# API de Gestión Dinámica de Imágenes (/api/admin/images) - Sin Panel ni Código
# ==============================================================================
# Clave secreta obligatoria (mínimo 16 caracteres) para autorizar cambios de imágenes
# Enviar en el header: Authorization: Bearer <ADMIN_IMAGE_API_KEY>
ADMIN_IMAGE_API_KEY=genera_aqui_un_token_secreto_largo_de_al_menos_32_caracteres

# Almacenamiento Cloud Serverless (Cloudinary - Capa gratuita de 25 GB para Vercel/Netlify)
# Si se dejan vacías en desarrollo local, la API guarda automáticamente en /public/images/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ejemplo de uso desde terminal (cURL) o Postman:
# curl -X POST http://localhost:3000/api/admin/images \
#   -H "Authorization: Bearer TU_ADMIN_IMAGE_API_KEY" \
#   -F "slot=clinic_1" \
#   -F "file=@C:/ruta/a/tu/foto.jpg"
#
# Para restaurar la imagen original de un slot:
# curl -X DELETE "http://localhost:3000/api/admin/images?slot=clinic_1" \
#   -H "Authorization: Bearer TU_ADMIN_IMAGE_API_KEY"

# ==============================================================================
# Conexión Supabase (PostgreSQL & Auth)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

